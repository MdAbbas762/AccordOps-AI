# AccordOps reference settings. Runtime secrets belong in backend/.env and n8n/.env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
AI_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
N8N_BASE_URL=http://localhost:5678
N8N_EVIDENCE_WEBHOOK_URL=http://localhost:5678/webhook/accordops-evidence-monitor
N8N_ACTION_WEBHOOK_URL=http://localhost:5678/webhook/accordops-approved-remediation
N8N_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_API_URL=http://localhost:8000
