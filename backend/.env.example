APP_NAME=AccordOps AI API
APP_VERSION=0.3.0
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=http://host.docker.internal:8000/api/v1

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# auto = Gemini when a key exists, otherwise transparent Python local-rules mode
AI_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Run scripts/prepare-n8n.ps1 after backend/.env exists.
N8N_BASE_URL=http://localhost:5678
N8N_EVIDENCE_WEBHOOK_URL=http://localhost:5678/webhook/accordops-evidence-monitor
N8N_ACTION_WEBHOOK_URL=http://localhost:5678/webhook/accordops-approved-remediation
N8N_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
